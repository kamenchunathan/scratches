build:
    meson compile -C build

setup:
    meson setup build

watch_lab binary_name:
    #!/bin/bash
    # set -euxo pipefail; 
    
    child_pid=""
    trap 'kill $child_pid 2>/dev/null; exit' SIGINT
    
    run() {
        if [ -n "$child_pid" ]; then
            kill $child_pid 2>/dev/null
        fi

        meson compile -C build {{binary_name}}
        if [ $? -eq 0 ]; then
            clear
            ./build/labs/{{binary_name}} &
            child_pid=$!
        fi
    }
    
    clear
    echo "Building..."
    run
    echo -e "\n"
    
    while inotifywait -q -e modify labs/{{binary_name}}.cpp; do
        clear
        echo "Rebuilding..."
        run
    done
